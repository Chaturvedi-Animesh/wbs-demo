        <name>createHistoryRecord</name>
        <script><![CDATA[var createHistoryRecord = Class.create();
createHistoryRecord.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

    wbsHistoryRecord: function() {

        var sysID = this.getParameter('sysparm_wbs');
        var comments = this.getParameter('sysparm_reason');
		gs.info('CH : '+sysID +' -- '+comments);

        var ch = new GlideRecord('x_1040502_wbs_change_history');
        ch.addEncodedQuery('budget=' +sysID +'^reason=NULL');
        ch.query();
        while (ch.next()) {
            ch.reason = comments;
			gs.info('reason '+comments);
            ch.update();
        }

    },
    type: 'createHistoryRecord'
});]]></script>
