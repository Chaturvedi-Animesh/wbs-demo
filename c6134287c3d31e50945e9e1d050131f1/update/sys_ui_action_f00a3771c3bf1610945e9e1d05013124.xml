        <action_name>submit_record</action_name>
        <active>true</active>
        <client>true</client>
        <client_script_v2><![CDATA[ function onClick(g_form) {
	

	g_modal.showFields({
        title: "",
        fields: [{
            type: 'textarea',
            name: 'work_notes',
            label: getMessage('Justification for Reason : '),
            mandatory: true
        }],
        size: 'lg'
		
    }).then(function(fieldValues) {
        var ga = new GlideAjax('createHistoryRecord');
        ga.addParam('sysparm_name', 'wbsHistoryRecord');
        ga.addParam('sysparm_wbs', g_form.getUniqueValue());
        ga.addParam('sysparm_reason', fieldValues.updatedFields[0].value);
		g_form.setValue('state',10);
		g_form.submit('submit_record');
        ga.getXMLAnswer(function(response) {});
    });
	
}
]]></client_script_v2>
