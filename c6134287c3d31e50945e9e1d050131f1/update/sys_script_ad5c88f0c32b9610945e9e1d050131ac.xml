        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

var months =["u_january","u_february","u_march","u_april","u_may","u_june","u_july","u_august","u_september","u_october","u_november","u_december"];
var choices =["january","february","march", "april","may","june", "july","august", "september","october","november","december"];

gs.info("BR 1 : "+current.sys_id);

for(var i=0;i<months.length;i++){
	var bud = new GlideRecord("x_1040502_wbs_budget");
	bud.initialize();
	bud.u_wbs = current.sys_id;
	bud.u_total_budget = current.getValue("u_total_budget");
	bud.year = current.getValue("u_year");
	bud.u_month = choices[i];
	bud.u_budget_estimate = current.getValue(months[i]);
	bud.insert();
    gs.info("BR 2 : "+bud.number);

}

})(current, previous);]]></script>
