        <script><![CDATA[function onLoad() {
    var year = new Date().getFullYear();
    for (var i = 0; i <= 10; i++) {
        var choices = year + i;
        g_form.addOption('year', choices, choices);
    }

    var currentMonth = new Date().getMonth();
    var allMonths = {
        0: 'january',
        1: 'february',
        2: 'march',
        3: 'april',
        4: 'may',
        5: 'june',
        6: 'july',
        7: 'august',
        8: 'september',
        9: 'october',
        10: 'november',
        11: 'december'
    }
    for (var month in allMonths) {
        if (parseInt(month) < currentMonth) {
            g_form.setReadOnly(allMonths[month], true);
        }
    }

}]]></script>
