        <name>checkWBSRecords</name>
        <script><![CDATA[var checkWBSRecords = Class.create();
checkWBSRecords.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {

	getCheckWbs: function() {
        var wb = [];
        var ch = new GlideRecord('x_1040502_wbs_budget');
        ch.query();
        while (ch.next()) {
            if (!ch.u_wbs.nil()) {
                wb.push(ch.u_wbs.toString());
            }
        }
        if (wb.length > 0) {
            return 'sys_idNOT IN' + wb.join(',');
        } else {
            return '';
        }

    },

    type: 'checkWBSRecords'
});]]></script>
