        <messages/>
        <name>Populate total budget and year</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }
   var wbsSysId = g_form.getValue('u_wbs');
   var ga = new GlideAjax('createHistoryRecord');
        ga.addParam('sysparm_name', 'getBudgetFromWBS');
        ga.addParam('sysparm_value', wbsSysId);
		ga.getXMLAnswer(function(response) {
			var ans = JSON.parse(response);
			//alert(ans.totalB);
				g_form.setValue('u_total_budget',ans.totalB.toString());
				g_form.setValue('u_year',ans.year);
		})
   
}]]></script>
