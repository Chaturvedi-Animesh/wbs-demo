        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {
    var appH = new GlideRecord("u_approval_history");
    appH.addEncodedQuery("parent=" +current.sys_id);
    appH.query();
    if (appH.hasNext()) {
        var fields = ["activity_type", "department", "channel", "main_expense", "activity", "campaign", "sub_expense", "product_category", "advertising_type", "u_description", "u_project_type", "u_number_range","u_year","u_total_budget"];
        fields.forEach(function(field) {
            if (current[field] != previous[field]) {
                var h = new GlideRecord("x_1040502_wbs_change_history");
                h.initialize();
                h.month = current[field].getLabel();
                h.budget = current.sys_id;
                h.old_value = previous[field];
                h.new_value = current[field];
				h.reason = current.u_reason.getJournalEntry(1).match(/\n.*/gm).join("\n");
				//h.reason = current.u_reason;
                h.insert();

            }
        });

    }

})(current, previous);]]></script>
