        <script><![CDATA[function transform(input) {
    var total = input.totalB;
    var year = input.year;
    var months = input.months;
	var number = input.number;
    var choices = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];

    gs.info('BR 1 : ' + months +' -- '+number+'-- '+year);
	var wbs = new GlideRecord('x_1040502_wbs_wbs');
	wbs.addQuery('number',input.number.trim());
	//var sysID = gr.sys_id;
	wbs.query();
	if(wbs.next()){
	gs.info('SYSID'+wbs.sys_id);

    for (var i = 0; i < months.length; i++) {
        var bud = new GlideRecord('x_1040502_wbs_budget');
        bud.initialize();
        bud.u_wbs = wbs.sys_id;
        bud.u_total_budget = total.replace(/\₫/g,"");
        bud.year = year;
        bud.u_month = choices[i];
        bud.u_budget = months[i].replace(/\₫/g,"");
        bud.insert();
        gs.info('BR 2 : ' + bud.number);

    }
	}

}]]></script>
